{
  "name": "sculptr-docs",
  "private": true,
  "scripts": {
    "dev": "docusaurus start --no-open",
    "build": "docusaurus build --out-dir dist",
    "serve": "docusaurus serve --dir dist",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "//": "No \"type\": \"module\" here. Docusaurus generates .docusaurus/registry.js as a .js file that mixes ESM with require.resolveWeak; under \"type\": \"module\" webpack treats it as strict ESM, leaves both untransformed, and the SSG build dies with \"require.resolveWeak is not a function\"."
}
